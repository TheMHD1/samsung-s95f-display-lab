# /storage/.config/system.d/linefix-relay.service
[Unit]
Description=OLED line fix relay (profile switching, Pixel Shift follow, self-heal)
After=kodi.service network-online.target

[Service]
ExecStart=/usr/bin/python3 /storage/linefix/relay.py
Restart=always
RestartSec=3

[Install]
WantedBy=kodi.service
